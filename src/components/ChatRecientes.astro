---
export interface ChatItem {
	id: string;
	title: string;
}

export interface Props {
	chats?: ChatItem[];
}

const { chats = [] } = Astro.props;
---

<div
	class="hidden fixed inset-0 top-16 bg-black/50 z-30 lg:hidden"
	id="sidebarBackdrop"
></div>

<aside
	class="fixed left-0 top-16 h-[calc(100vh-64px)] w-72 max-w-[85vw] bg-surface-container-lowest border-r border-outline-variant z-40 overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
	id="sidebar"
>
	<div class="p-lg">
		<div class="flex items-center justify-between mb-lg">
			<span class="font-label-sm text-on-secondary-container tracking-wider uppercase">Recent Chats</span>
			<button class="p-xs text-on-surface-variant hover:text-primary transition-colors" id="newChatBtn" title="Nueva conversación">
				<span class="material-symbols-outlined">add_comment</span>
			</button>
		</div>
		<nav class="space-y-base" id="chatList" data-active-classes="bg-surface-container-high text-on-surface">
			{
				chats.map((chat: ChatItem) => (
					<a
						class="flex items-center gap-md px-md py-sm rounded-lg text-body-sm text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all"
						data-path={chat.id}
						href="#"
					>
						<span class="material-symbols-outlined">chat_bubble</span>
						<span class="truncate">{chat.title}</span>
					</a>
				))
			}
		</nav>
	</div>
</aside>

<script>
	const sidebar = document.getElementById("sidebar") as HTMLElement;
	const backdrop = document.getElementById("sidebarBackdrop") as HTMLElement;

	function openSidebar() {
		sidebar.classList.remove("-translate-x-full");
		backdrop.classList.remove("hidden");
	}

	function closeSidebar() {
		sidebar.classList.add("-translate-x-full");
		backdrop.classList.add("hidden");
	}

	function isSidebarOpen() {
		return !sidebar.classList.contains("-translate-x-full");
	}

	document.addEventListener("toggle-sidebar", () => {
		if (isSidebarOpen()) {
			closeSidebar();
		} else {
			openSidebar();
		}
	});

	backdrop.addEventListener("click", closeSidebar);

	sidebar.addEventListener("click", (event) => {
		const link = (event.target as HTMLElement).closest("a[data-path]");
		if (link && window.matchMedia("(max-width: 1023px)").matches) {
			closeSidebar();
		}
	});

	window.addEventListener("resize", () => {
		if (window.matchMedia("(min-width: 1024px)").matches) {
			backdrop.classList.add("hidden");
		}
	});
</script>
