---
export interface Props {
	title?: string;
}

const { title = "Aura Chat" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark light" />
		<title>{title}</title>
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("aura_theme");
				var theme = stored === "light" ? "light" : "dark";
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<style>
			@layer base {
				html,
				body {
					margin: 0;
					padding: 0;
				}
				body {
					overscroll-behavior: none;
					overflow-x: hidden;
					transition: background-color 0.2s ease;
				}
				main > :first-child {
					margin-top: 0 !important;
				}
				main > :last-child {
					margin-bottom: 0 !important;
				}
			}
			::-webkit-scrollbar {
				display: none;
			}

			:root {
				color-scheme: dark;
				--color-surface-container-highest: 45 52 73;
				--color-outline-variant: 67 70 85;
				--color-outline: 51 65 85;
				--color-surface: 11 19 38;
				--color-on-primary-fixed-variant: 0 62 168;
				--color-inverse-on-surface: 40 48 68;
				--color-inverse-surface: 218 226 253;
				--color-surface-container-high: 34 42 61;
				--color-on-secondary-container: 169 186 211;
				--color-on-primary-container: 238 239 255;
				--color-on-surface: 248 250 252;
				--color-on-background: 218 226 253;
				--color-surface-bright: 49 57 77;
				--color-surface-variant: 45 52 73;
				--color-on-tertiary-container: 255 237 230;
				--color-on-secondary: 33 49 69;
				--color-error-container: 147 0 10;
				--color-secondary: 183 200 225;
				--color-on-secondary-fixed-variant: 56 72 93;
				--color-primary-fixed-dim: 180 197 255;
				--color-on-primary: 0 42 120;
				--color-on-tertiary: 88 30 0;
				--color-success: 16 185 129;
				--color-surface-container-low: 19 27 46;
				--color-on-error-container: 255 218 214;
				--color-secondary-container: 58 74 95;
				--color-on-surface-variant: 195 198 215;
				--color-on-secondary-fixed: 11 28 48;
				--color-error: 239 68 68;
				--color-primary-fixed: 219 225 255;
				--color-secondary-fixed-dim: 183 200 225;
				--color-tertiary: 255 181 150;
				--color-surface-container: 23 31 51;
				--color-primary: 180 197 255;
				--color-surface-container-lowest: 6 14 32;
				--color-surface-tint: 180 197 255;
				--color-tertiary-fixed: 255 219 205;
				--color-surface-dim: 11 19 38;
				--color-on-tertiary-fixed-variant: 125 45 0;
				--color-secondary-fixed: 211 228 254;
				--color-on-primary-fixed: 0 23 75;
				--color-background: 11 19 38;
				--color-tertiary-fixed-dim: 255 181 150;
				--color-tertiary-container: 188 72 0;
				--color-on-error: 105 0 5;
				--color-primary-container: 37 99 235;
				--color-on-tertiary-fixed: 54 15 0;
				--color-inverse-primary: 0 83 219;
			}

			:root[data-theme="light"] {
				color-scheme: light;
				--color-surface-container-highest: 223 226 237;
				--color-outline-variant: 196 198 207;
				--color-outline: 116 119 127;
				--color-surface: 247 249 253;
				--color-inverse-on-surface: 248 250 252;
				--color-inverse-surface: 11 19 38;
				--color-surface-container-high: 229 232 242;
				--color-on-secondary-container: 11 28 48;
				--color-on-primary-container: 0 23 75;
				--color-on-surface: 18 21 28;
				--color-on-background: 18 21 28;
				--color-surface-bright: 247 249 253;
				--color-surface-variant: 223 226 237;
				--color-on-tertiary-container: 54 15 0;
				--color-on-secondary: 255 255 255;
				--color-error-container: 255 218 214;
				--color-secondary: 69 89 111;
				--color-on-primary: 255 255 255;
				--color-on-tertiary: 255 255 255;
				--color-surface-container-low: 241 243 250;
				--color-on-error-container: 65 0 2;
				--color-secondary-container: 211 228 254;
				--color-on-surface-variant: 68 71 78;
				--color-error: 186 26 26;
				--color-tertiary: 154 59 0;
				--color-surface-container: 235 238 247;
				--color-primary: 37 99 235;
				--color-surface-container-lowest: 255 255 255;
				--color-surface-tint: 37 99 235;
				--color-surface-dim: 217 222 233;
				--color-background: 247 249 253;
				--color-tertiary-container: 255 219 205;
				--color-on-error: 255 255 255;
				--color-primary-container: 219 225 255;
				--color-inverse-primary: 180 197 255;
			}
		</style>
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<script is:inline id="tailwind-config">
			tailwind.config = {
				darkMode: "class",
				theme: {
					extend: {
						colors: {
							"surface-container-highest": "rgb(var(--color-surface-container-highest) / <alpha-value>)",
							"outline-variant": "rgb(var(--color-outline-variant) / <alpha-value>)",
							outline: "rgb(var(--color-outline) / <alpha-value>)",
							surface: "rgb(var(--color-surface) / <alpha-value>)",
							"on-primary-fixed-variant": "rgb(var(--color-on-primary-fixed-variant) / <alpha-value>)",
							"inverse-on-surface": "rgb(var(--color-inverse-on-surface) / <alpha-value>)",
							"inverse-surface": "rgb(var(--color-inverse-surface) / <alpha-value>)",
							"surface-container-high": "rgb(var(--color-surface-container-high) / <alpha-value>)",
							"on-secondary-container": "rgb(var(--color-on-secondary-container) / <alpha-value>)",
							"on-primary-container": "rgb(var(--color-on-primary-container) / <alpha-value>)",
							"on-surface": "rgb(var(--color-on-surface) / <alpha-value>)",
							"on-background": "rgb(var(--color-on-background) / <alpha-value>)",
							"surface-bright": "rgb(var(--color-surface-bright) / <alpha-value>)",
							"surface-variant": "rgb(var(--color-surface-variant) / <alpha-value>)",
							"on-tertiary-container": "rgb(var(--color-on-tertiary-container) / <alpha-value>)",
							"on-secondary": "rgb(var(--color-on-secondary) / <alpha-value>)",
							"error-container": "rgb(var(--color-error-container) / <alpha-value>)",
							secondary: "rgb(var(--color-secondary) / <alpha-value>)",
							"on-secondary-fixed-variant": "rgb(var(--color-on-secondary-fixed-variant) / <alpha-value>)",
							"primary-fixed-dim": "rgb(var(--color-primary-fixed-dim) / <alpha-value>)",
							"on-primary": "rgb(var(--color-on-primary) / <alpha-value>)",
							"on-tertiary": "rgb(var(--color-on-tertiary) / <alpha-value>)",
							success: "rgb(var(--color-success) / <alpha-value>)",
							"surface-container-low": "rgb(var(--color-surface-container-low) / <alpha-value>)",
							"on-error-container": "rgb(var(--color-on-error-container) / <alpha-value>)",
							"secondary-container": "rgb(var(--color-secondary-container) / <alpha-value>)",
							"on-surface-variant": "rgb(var(--color-on-surface-variant) / <alpha-value>)",
							"on-secondary-fixed": "rgb(var(--color-on-secondary-fixed) / <alpha-value>)",
							error: "rgb(var(--color-error) / <alpha-value>)",
							"primary-fixed": "rgb(var(--color-primary-fixed) / <alpha-value>)",
							"secondary-fixed-dim": "rgb(var(--color-secondary-fixed-dim) / <alpha-value>)",
							tertiary: "rgb(var(--color-tertiary) / <alpha-value>)",
							"surface-container": "rgb(var(--color-surface-container) / <alpha-value>)",
							primary: "rgb(var(--color-primary) / <alpha-value>)",
							"surface-container-lowest": "rgb(var(--color-surface-container-lowest) / <alpha-value>)",
							"surface-tint": "rgb(var(--color-surface-tint) / <alpha-value>)",
							"tertiary-fixed": "rgb(var(--color-tertiary-fixed) / <alpha-value>)",
							"surface-dim": "rgb(var(--color-surface-dim) / <alpha-value>)",
							"on-tertiary-fixed-variant": "rgb(var(--color-on-tertiary-fixed-variant) / <alpha-value>)",
							"secondary-fixed": "rgb(var(--color-secondary-fixed) / <alpha-value>)",
							"on-primary-fixed": "rgb(var(--color-on-primary-fixed) / <alpha-value>)",
							background: "rgb(var(--color-background) / <alpha-value>)",
							"tertiary-fixed-dim": "rgb(var(--color-tertiary-fixed-dim) / <alpha-value>)",
							"tertiary-container": "rgb(var(--color-tertiary-container) / <alpha-value>)",
							"on-error": "rgb(var(--color-on-error) / <alpha-value>)",
							"primary-container": "rgb(var(--color-primary-container) / <alpha-value>)",
							"on-tertiary-fixed": "rgb(var(--color-on-tertiary-fixed) / <alpha-value>)",
							"inverse-primary": "rgb(var(--color-inverse-primary) / <alpha-value>)",
						},
						borderRadius: {
							DEFAULT: "0.25rem",
							lg: "0.5rem",
							xl: "0.75rem",
							full: "9999px",
						},
						spacing: {
							lg: "24px",
							xl: "40px",
							sm: "8px",
							gutter: "24px",
							base: "4px",
							md: "16px",
							xs: "4px",
							"margin-desktop": "64px",
							"margin-mobile": "16px",
						},
						fontFamily: {
							"headline-lg-mobile": ["Inter"],
							"label-md": ["Inter"],
							"body-md": ["Inter"],
							"body-lg": ["Inter"],
							"headline-md": ["Inter"],
							"body-sm": ["Inter"],
							display: ["Inter"],
							"headline-lg": ["Inter"],
							"label-sm": ["Inter"],
						},
						fontSize: {
							"headline-lg-mobile": ["24px", { lineHeight: "32px", fontWeight: "600" }],
							"label-md": ["14px", { lineHeight: "20px", letterSpacing: "0.01em", fontWeight: "500" }],
							"body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
							"body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
							"headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
							"body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }],
							display: ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
							"headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "600" }],
							"label-sm": ["12px", { lineHeight: "16px", fontWeight: "600" }],
						},
					},
				},
			};
		</script>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
	</head>
	<body class="bg-surface font-body-md text-on-surface">
		<slot />
	</body>
</html>
